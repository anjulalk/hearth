{
  "name": "hearth",
  "description": "Keep the screen on while AI agents run, with a black, low-power screensaver",
  "author": {
    "name": "Anjula Karunarathne",
    "url": "https://anjula.dev"
  },
  "license": "MIT",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/anjulalk/hearth.git"
  },
  "homepage": "https://hearth.anjula.dev",
  "bugs": {
    "url": "https://github.com/anjulalk/hearth/issues"
  },
  "keywords": [
    "screen-wake-lock",
    "keep-awake",
    "screensaver",
    "oled",
    "vue",
    "vite",
    "typescript"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:update": "npm run build && playwright test --update-snapshots",
    "smoke": "node scripts/smoke.mts",
    "verify:headed": "node scripts/verify-headed.mts",
    "assets": "node scripts/make-assets.mts"
  },
  "dependencies": {
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": ">=20"
  }
}
